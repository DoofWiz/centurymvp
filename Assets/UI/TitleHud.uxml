<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="century.uss" />

    <!--
      Title screen. The word CENTURY itself is 3D text in the scene behind this document; the
      document carries only the two actions and the save overlay. The actions are free-floating
      text with no container: hovering lights them and grows an underline out from the centre.
      Element names are the contract with TitleController (App layer).
    -->
    <ui:VisualElement name="root" class="hud-root" picking-mode="Ignore">

        <ui:VisualElement name="title-menu" class="title-menu" picking-mode="Ignore">
            <ui:Label text="AFTER TEUTOBURG" class="title-menu__eyebrow" />

            <ui:Button name="title-start" class="title-link">
                <ui:Label text="START PROTOTYPE" class="title-link__label" picking-mode="Ignore" />
                <ui:VisualElement class="title-link__underline" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="title-load" class="title-link">
                <ui:Label text="LOAD SAVE" class="title-link__label" picking-mode="Ignore" />
                <ui:VisualElement class="title-link__underline" picking-mode="Ignore" />
            </ui:Button>

            <ui:Label name="title-version" text="PROTOTYPE" class="title-menu__version" />
        </ui:VisualElement>

        <!-- ================================ SAVE SLOTS ================================ -->
        <ui:VisualElement name="save-modal" class="modal" style="display: none;">
            <ui:VisualElement class="modal__sheet save-sheet">
                <ui:VisualElement class="save-head">
                    <ui:VisualElement picking-mode="Ignore">
                        <ui:Label name="save-title" text="LOAD SAVE" class="modal__title" />
                        <ui:Label name="save-subtitle" text="Choose a slot" class="modal__subtitle" />
                    </ui:VisualElement>
                    <ui:Button name="save-close" class="save-close">
                        <ui:Label text="X" class="save-close__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement name="save-slots" class="save-slots">
                    <ui:Button name="save-slot-0" class="save-slot">
                        <ui:Label text="I" class="save-slot__numeral" picking-mode="Ignore" />
                        <ui:VisualElement class="save-slot__text" picking-mode="Ignore">
                            <ui:Label name="save-slot-title-0" text="EMPTY SLOT" class="save-slot__title" picking-mode="Ignore" />
                            <ui:Label name="save-slot-detail-0" text="" class="save-slot__detail" picking-mode="Ignore" />
                            <ui:Label name="save-slot-date-0" text="" class="save-slot__date" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="save-slot-1" class="save-slot">
                        <ui:Label text="II" class="save-slot__numeral" picking-mode="Ignore" />
                        <ui:VisualElement class="save-slot__text" picking-mode="Ignore">
                            <ui:Label name="save-slot-title-1" text="EMPTY SLOT" class="save-slot__title" picking-mode="Ignore" />
                            <ui:Label name="save-slot-detail-1" text="" class="save-slot__detail" picking-mode="Ignore" />
                            <ui:Label name="save-slot-date-1" text="" class="save-slot__date" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="save-slot-2" class="save-slot">
                        <ui:Label text="III" class="save-slot__numeral" picking-mode="Ignore" />
                        <ui:VisualElement class="save-slot__text" picking-mode="Ignore">
                            <ui:Label name="save-slot-title-2" text="EMPTY SLOT" class="save-slot__title" picking-mode="Ignore" />
                            <ui:Label name="save-slot-detail-2" text="" class="save-slot__detail" picking-mode="Ignore" />
                            <ui:Label name="save-slot-date-2" text="" class="save-slot__date" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="modal__footer save-footer">
                    <ui:Label name="save-status" text="" class="body body--dim" />
                    <ui:VisualElement class="save-footer__actions">
                        <ui:Button name="save-delete" class="button-ghost">
                            <ui:Label text="DELETE" class="button-ghost__label" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="save-action" class="button-start">
                            <ui:Label name="save-action-label" text="LOAD" class="button-start__label" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
