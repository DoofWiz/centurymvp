/* =======================================================================================
 *  KEY CAPS (Kenney Input Prompts)
 *  Real keyboard icons wherever the UI names a key. Tinted umber so they read as ink
 *  on the parchment chrome.
 * ======================================================================================= */

/* --- Key caps: real keyboard icons where the UI names a key ----------------------------- */

.command__key {
    width: 22px;
    height: 22px;
    font-size: 0;
    opacity: 0.9;
    -unity-background-image-tint-color: rgb(74, 54, 32);
}

.keycap--1 { background-image: url("KenneyInputIcons/Keyboard & Mouse/Double/keyboard_1_outline.png"); }
.keycap--2 { background-image: url("KenneyInputIcons/Keyboard & Mouse/Double/keyboard_2_outline.png"); }
.keycap--3 { background-image: url("KenneyInputIcons/Keyboard & Mouse/Double/keyboard_3_outline.png"); }
.keycap--4 { background-image: url("KenneyInputIcons/Keyboard & Mouse/Double/keyboard_4_outline.png"); }
.keycap--5 { background-image: url("KenneyInputIcons/Keyboard & Mouse/Double/keyboard_5_outline.png"); }
.keycap--6 { background-image: url("KenneyInputIcons/Keyboard & Mouse/Double/keyboard_6_outline.png"); }
.keycap--7 { background-image: url("KenneyInputIcons/Keyboard & Mouse/Double/keyboard_7_outline.png"); }
.keycap--8 { background-image: url("KenneyInputIcons/Keyboard & Mouse/Double/keyboard_8_outline.png"); }
.keycap--space { background-image: url("KenneyInputIcons/Keyboard & Mouse/Double/keyboard_space_outline.png"); }

.hint-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.hint-row .keycap {
    width: 26px;
    height: 26px;
    margin-right: 5px;
    opacity: 0.8;
    -unity-background-image-tint-color: rgb(74, 54, 32);
}

/* =======================================================================================
 *  The army layer: office tradition cards + contubernium cards
 *  One visual language on both surfaces: the camp's THE OFFICES tab (interactive) and the
 *  ARMY screen (read-only). Three node states only: held (solid gold), ready (lit),
 *  locked (dim) - and the single clickable thing on a card is also the single lit thing.
 * ======================================================================================= */

.office-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-top: var(--pad-tight);
}

/* The camp's office overlay: one card, given the sheet. */
.office-sheet {
    width: 600px;
    max-height: 86%;
}

.office-body { flex-grow: 1; }

/* Inside the sheet the card IS the content: no frame-within-a-frame, full width. */
.office-body .office-card {
    flex-basis: auto;
    max-width: none;
    margin-right: 0;
    margin-bottom: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    padding: 0 var(--pad-tight);
}

/* Unspent tradition points waiting on an officer slot. */
.badge--points {
    color: var(--gold-bright);
    background-color: var(--gold-faint);
    border-color: var(--gold-dim);
}

.office-card {
    flex-basis: 300px;
    flex-grow: 1;
    max-width: 560px;
    margin-right: var(--pad);
    margin-bottom: var(--pad);
    padding: var(--pad-loose);
    background-color: var(--ink-deep);
    border-width: var(--rule);
    border-color: var(--gold-dim);
}

.office-card--vacant { border-color: var(--blood-dim); }

.office-card__post {
    font-size: var(--font-size-large);
    color: var(--gold);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.office-card__holder {
    font-size: var(--font-size-body);
    color: var(--parchment);
    margin-top: 3px;
}

.office-card__holder--vacant { color: var(--blood); }

.office-card__charge {
    font-size: var(--font-size-small);
    color: var(--parchment-dim);
    white-space: normal;
    margin-top: 3px;
}

.office-card__penalty {
    font-size: var(--font-size-small);
    color: var(--blood);
    white-space: normal;
    margin-top: 5px;
}

.office-card__points {
    margin-top: var(--pad);
    padding: 5px 8px;
    font-size: var(--font-size-small);
    letter-spacing: 2px;
    color: var(--gold-bright);
    background-color: var(--gold-faint);
    border-width: var(--rule);
    border-color: var(--gold-dim);
}

.office-card__points--none {
    color: var(--parchment-faint);
    background-color: rgba(74, 54, 32, 0.1);
    border-color: rgba(74, 54, 32, 0.3);
}

.office-track { margin-top: var(--pad); }

.office-track__rail {
    position: absolute;
    left: 7px;
    top: 12px;
    bottom: 12px;
    width: 1px;
    background-color: var(--gold-dim);
}

/* A vacant office keeps its tree visible but clearly out of reach. */
.office-card--vacant .office-track { opacity: 0.45; }

.trad-node {
    flex-direction: row;
    padding: 6px 6px 6px 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

Button.trad-node:hover { background-color: rgba(154, 123, 58, 0.18); }

.trad-node__marker {
    width: 15px;
    height: 15px;
    margin-top: 2px;
    margin-right: 10px;
    flex-shrink: 0;
    border-width: var(--rule);
    border-color: var(--parchment-faint);
    background-color: var(--ink-solid);
}

.trad-node--held .trad-node__marker {
    background-color: var(--gold);
    border-color: var(--gold);
}

.trad-node--ready .trad-node__marker {
    border-color: var(--gold-bright);
    background-color: var(--gold-faint);
}

.trad-node__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.trad-node__head {
    flex-direction: row;
    align-items: center;
}

.trad-node__rank {
    width: 26px;
    flex-shrink: 0;
    font-size: var(--font-size-small);
    color: var(--parchment-faint);
    letter-spacing: 1px;
}

.trad-node__name {
    font-size: var(--font-size-body);
    color: var(--parchment);
    letter-spacing: 1px;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.trad-node__cost {
    font-size: var(--font-size-small);
    color: var(--parchment-dim);
    letter-spacing: 1px;
    margin-left: 8px;
    flex-shrink: 0;
}

.trad-node--held .trad-node__cost { color: var(--gold); }
.trad-node--ready .trad-node__cost { color: var(--gold-bright); }

.trad-node__effect {
    font-size: var(--font-size-small);
    color: var(--parchment-dim);
    white-space: normal;
    margin-top: 2px;
}

.trad-node--locked .trad-node__name { color: var(--parchment-faint); }
.trad-node--locked .trad-node__effect { color: var(--parchment-faint); }

.office-card__note {
    margin-top: var(--pad-tight);
    font-size: var(--font-size-small);
    color: var(--parchment-dim);
    white-space: normal;
}

/* --- Contubernium cards (ARMY screen): strength reads before a single name does. -------- */

.squad-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-top: var(--pad-tight);
}

.squad-card {
    flex-basis: 280px;
    flex-grow: 1;
    max-width: 460px;
    margin-right: var(--pad);
    margin-bottom: var(--pad);
    padding: var(--pad);
    background-color: var(--ink-deep);
    border-width: var(--rule);
    border-color: var(--gold-faint);
}

.squad-card__head {
    flex-direction: row;
    align-items: center;
}

.squad-card__title {
    font-size: var(--font-size-body);
    color: var(--parchment);
    letter-spacing: 2px;
    flex-grow: 1;
}

.squad-card__count {
    font-size: var(--font-size-small);
    color: var(--parchment-dim);
}

.pip-row {
    flex-direction: row;
    margin-top: 6px;
}

.pip {
    width: 20px;
    height: 6px;
    margin-right: 4px;
    background-color: var(--olive);
}

.pip--wounded { background-color: var(--brass); }

.pip--empty {
    background-color: rgba(74, 54, 32, 0.12);
    border-width: var(--rule);
    border-color: rgba(74, 54, 32, 0.35);
}

.squad-card__decanus {
    margin-top: 6px;
    font-size: var(--font-size-small);
    color: var(--gold-bright);
}

.squad-card__decanus--none { color: var(--blood); }

.squad-card__men {
    margin-top: 3px;
    font-size: var(--font-size-small);
    color: var(--parchment-dim);
    white-space: normal;
}

/* =======================================================================================
 *  Tier discs + the relationship layer
 *  Discs are geometry, not unicode glyphs: the thematic font carves circle/diamond
 *  characters badly and WebGL has no OS fallback. A border-radius disc renders the same
 *  at every scale on every platform.
 * ======================================================================================= */

.tier-disc {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 1px;
    flex-shrink: 0;
    align-self: center;
    background-color: var(--parchment-dim);
    border-color: rgba(58, 44, 26, 0.6);
}

.tier-disc--tiro {
    background-color: rgba(74, 54, 32, 0.14);
    border-color: var(--parchment-faint);
}

.tier-disc--miles {
    background-color: var(--parchment-dim);
    border-color: var(--parchment-dim);
}

.tier-disc--veteranus {
    background-color: var(--brass);
    border-color: var(--brass);
}

.tier-disc--evocatus {
    background-color: var(--gold);
    border-color: var(--gold-bright);
}

.tier-disc--officer {
    background-color: var(--blood);
    border-color: rgb(94, 29, 20);
}

.tier-disc--vacant {
    background-color: rgba(74, 54, 32, 0.08);
    border-color: var(--blood-dim);
}

.tier-disc--card {
    margin-right: 8px;
    margin-top: 3px;
    align-self: flex-start;
}

.tier-disc--pick { margin-right: var(--pad-tight); }

.tier-disc--large {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 2px;
    margin-right: 10px;
}

.officer-slot__crest-disc {
    margin-right: 8px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
}

/* --- Bonds and grudges (soldier detail) ------------------------------------------------- */

.soldier-ties { margin-top: 2px; }

.tie-row { margin-top: 4px; }

.tie-row__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.tie-row__name {
    font-size: var(--font-size-small);
    color: var(--parchment);
}

.tie-row__band {
    font-size: var(--font-size-small);
    color: var(--parchment-dim);
    margin-left: 8px;
    flex-shrink: 0;
}

.tie-row__why {
    font-size: var(--font-size-micro);
    color: var(--parchment-faint);
    white-space: normal;
    margin-top: 1px;
}

.tie-empty {
    font-size: var(--font-size-small);
    color: var(--parchment-faint);
    margin-top: 3px;
    white-space: normal;
}

/* --- ARMY screen navigation (root / squad / man pages) ----------------------------------- */

.army-back {
    align-self: flex-start;
    margin-bottom: var(--pad-tight);
    padding: 4px 12px;
    background-color: var(--paper-raise);
    border-width: var(--rule);
    border-color: var(--gold-dim);
    border-radius: 0;
    color: var(--gold-bright);
    font-size: var(--font-size-small);
    letter-spacing: 2px;
}

.army-back:hover {
    background-color: rgba(154, 123, 58, 0.2);
    border-color: var(--brass);
}

.army-man__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--pad-tight);
}

.army-man__name {
    font-size: var(--font-size-title);
    color: var(--parchment);
    letter-spacing: 1px;
}

.army-man__rank {
    font-size: var(--font-size-small);
    color: var(--gold);
    letter-spacing: 1px;
    margin-top: 2px;
}

/* A holder's name that is a door to the man: plain text at rest, gold under the cursor. */
Button.office-card__holder--link {
    margin: 3px 0 0 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 0;
    -unity-text-align: upper-left;
}

Button.office-card__holder--link:hover { color: var(--gold-bright); }

/* A bond row that navigates to the other man. */
Button.tie-row--link {
    margin: 4px 0 0 0;
    padding: 3px 4px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 0;
}

Button.tie-row--link:hover { background-color: rgba(154, 123, 58, 0.18); }

/* Squad cards double as buttons on the ARMY screen. */
Button.squad-card {
    margin-top: 0;
    margin-left: 0;
    background-image: none;
    border-radius: 0;
}

Button.squad-card:hover { border-color: var(--gold); }

/* --- Veterancy ladder strip: the four steps in order, the current one lit ---------------- */

.tier-strip {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
    margin-bottom: 4px;
}

.tier-strip__step {
    font-size: var(--font-size-micro);
    letter-spacing: 1px;
    color: var(--parchment-faint);
    padding: 1px 6px;
    margin-right: 4px;
    border-width: var(--rule);
    border-color: rgba(74, 54, 32, 0.3);
    background-color: rgba(74, 54, 32, 0.1);
}

.tier-strip__step--past {
    color: var(--parchment-dim);
    border-color: var(--gold-dim);
    background-color: rgba(154, 123, 58, 0.12);
}

.tier-strip__step--current {
    color: var(--gold-bright);
    border-color: var(--gold);
    background-color: var(--gold-faint);
}

.tier-desc {
    font-size: var(--font-size-micro);
    color: var(--parchment-dim);
    white-space: normal;
    margin-top: 3px;
    margin-bottom: 2px;
}

/* --- First-load explainers (overmap + first battle) -------------------------------------- */

.intro-sheet {
    width: 680px;
    max-height: 88%;
}

.intro-row {
    flex-direction: row;
    margin-top: 8px;
    align-items: flex-start;
}

.intro-key {
    width: 120px;
    flex-shrink: 0;
    font-size: var(--font-size-small);
    color: var(--gold);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.intro-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--font-size-small);
    color: var(--parchment);
    white-space: normal;
}


/* =======================================================================================
 *  Onboarding flow: title screen, save slots, the decanus' narration, camp coach marks,
 *  and the opening sequence's subtitles and tutorial pop-ups.
 * ======================================================================================= */

/* --- Title screen --------------------------------------------------------------------- */
/* Free-floating text, no containers: bigger, brighter, and a gold underline that grows out
   from the centre of a hovered action. */

.title-menu {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 9%;
    align-items: center;
}

.title-menu__eyebrow {
    font-size: 18px;
    color: rgb(232, 226, 212);
    letter-spacing: 10px;
    -unity-font-style: bold;
    margin-bottom: 22px;
}

.title-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 10px;
    padding-bottom: 8px;
    margin-top: 6px;
    margin-bottom: 0;
    align-items: center;
}

.title-link:hover,
.title-link:active,
.title-link:focus {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.title-link__label {
    font-size: 34px;
    color: rgb(244, 240, 230);
    letter-spacing: 7px;
    -unity-font-style: bold;
    transition-property: color;
    transition-duration: 0.12s;
}

.title-link:hover .title-link__label { color: rgb(224, 192, 104); }

.title-link__underline {
    width: 100%;
    height: 2px;
    margin-top: 6px;
    background-color: rgb(224, 192, 104);
    scale: 0 1;
    transition-property: scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.title-link:hover .title-link__underline { scale: 1 1; }

.title-menu__version {
    margin-top: 30px;
    font-size: 13px;
    color: rgb(190, 184, 170);
    letter-spacing: 5px;
}

/* --- Save slots ------------------------------------------------------------------------ */

.save-sheet { width: 640px; }

.save-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
}

.save-close {
    background-color: var(--paper-raise);
    border-width: var(--rule);
    border-color: var(--gold-dim);
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
}

.save-close:hover { border-color: var(--gold-bright); }

.save-close__label {
    font-size: var(--font-size-body);
    color: var(--gold-bright);
    -unity-font-style: bold;
}

.save-slots { margin-top: 4px; }

.save-slot {
    flex-direction: row;
    align-items: center;
    background-color: var(--paper-raise);
    border-width: var(--rule);
    border-color: var(--gold-dim);
    border-left-width: 3px;
    border-left-color: var(--gold);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    margin-top: 8px;
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.save-slot:hover { border-color: var(--gold-bright); }

.save-slot--selected {
    background-color: rgba(255, 250, 232, 0.96);
    border-color: var(--brass);
}

.save-slot--empty { border-left-color: var(--parchment-faint); }

.save-slot__numeral {
    width: 44px;
    font-size: var(--font-size-title);
    color: var(--gold-bright);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.save-slot__text { flex-grow: 1; }

.save-slot__title {
    font-size: var(--font-size-body);
    color: var(--parchment);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.save-slot--empty .save-slot__title { color: var(--parchment-faint); }

.save-slot__detail {
    font-size: var(--font-size-small);
    color: var(--parchment-dim);
    margin-top: 2px;
}

.save-slot__date {
    font-size: var(--font-size-micro);
    color: var(--parchment-faint);
    letter-spacing: 1px;
    margin-top: 2px;
}

.save-footer__actions { flex-direction: row; align-items: center; }
.save-footer__actions .button-ghost { margin-right: 10px; }

/* --- Quit prompt (overmap) ------------------------------------------------------------- */

.quit-sheet { width: 520px; }

.quit-actions { flex-direction: row; align-items: center; }
.quit-actions .button-ghost { margin-left: 8px; }

/* --- Narration: the decanus speaks ----------------------------------------------------- */

.narration-sheet { width: 640px; }

.narration__speaker {
    font-size: var(--font-size-small);
    color: var(--gold);
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-top: 10px;
}

.narration__body {
    font-size: var(--font-size-body);
    color: var(--parchment);
    white-space: normal;
    margin-top: 8px;
}

/* --- Camp coach marks ------------------------------------------------------------------ */

.coach-panel {
    position: absolute;
    width: 380px;
    background-color: var(--ink-solid);
    border-width: 2px;
    border-color: var(--gold);
    padding: 14px;
}

.coach-panel__title {
    font-size: var(--font-size-large);
    color: var(--gold-bright);
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-top: 4px;
}

.coach-panel__body {
    font-size: var(--font-size-small);
    color: var(--parchment);
    white-space: normal;
    margin-top: 8px;
}

.coach-panel__footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
}

.coach-target {
    border-width: 2px;
    border-color: var(--brass);
    background-color: rgba(154, 123, 58, 0.3);
}

/* --- The opening sequence (battle scene, scripted) ------------------------------------- */

.opening-subtitle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14%;
    align-items: center;
    opacity: 0;
}

.opening-subtitle__text {
    font-size: var(--font-size-title);
    color: var(--parchment);
    letter-spacing: 2px;
    background-color: rgba(240, 231, 207, 0.85);
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 8px;
    padding-bottom: 8px;
    white-space: normal;
    max-width: 900px;
    -unity-text-align: middle-center;
}

.opening-tutorial {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    align-items: center;
}

.opening-tutorial__sheet {
    background-color: var(--ink-solid);
    border-width: 2px;
    border-color: var(--gold);
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 22px;
    padding-bottom: 22px;
    align-items: center;
    min-width: 440px;
    max-width: 640px;
}

.opening-tutorial__title {
    font-size: var(--font-size-alert);
    color: var(--gold-bright);
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.opening-tutorial__keys {
    font-size: var(--font-size-title);
    color: var(--parchment);
    letter-spacing: 4px;
    margin-top: 10px;
    -unity-font-style: bold;
}

.opening-tutorial__body {
    font-size: var(--font-size-body);
    color: var(--parchment-dim);
    white-space: normal;
    margin-top: 10px;
    -unity-text-align: middle-center;
}

.opening-tutorial__hint {
    font-size: var(--font-size-micro);
    color: var(--gold);
    letter-spacing: 3px;
    margin-top: 14px;
}

.opening-eyelid {
    position: absolute;
    left: 0;
    right: 0;
    background-color: rgb(23, 18, 11);
}

.opening-eyelid--top { top: 0; height: 0; }
.opening-eyelid--bottom { bottom: 0; height: 0; }

.opening-stealth {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6%;
    align-items: center;
    display: none;
}

.opening-stealth__label {
    font-size: var(--font-size-small);
    color: var(--gold-bright);
    letter-spacing: 5px;
    -unity-font-style: bold;
    background-color: rgba(240, 231, 207, 0.85);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* --- Overmap tutorial pop-ups: the opening's sheet, sat a little lower ------------------ */

.overmap-tutorial { top: 26%; }

.overmap-tutorial .opening-tutorial__body {
    color: var(--parchment);
    font-size: var(--font-size-large);
    max-width: 560px;
}
